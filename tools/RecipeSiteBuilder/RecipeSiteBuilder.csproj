<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.6.0" />
  </ItemGroup>

  <Target Name="GenerateRecipeWebsite" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and ('$(BuildingInsideVisualStudio)' == 'true' or '$(BuildingSolutionFile)' == 'true')">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; ."
          WorkingDirectory="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', '..'))" />
  </Target>

</Project>
